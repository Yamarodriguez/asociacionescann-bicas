# Copia documentada de las variables de entorno. Sin valores reales.
# En desarrollo, `npm run preparar` crea .env con secretos aleatorios.

# desarrollo | produccion
ENTORNO=desarrollo
# Puerto del servidor
PUERTO=8080
# 1 solo si un intermediario propio escribe X-Forwarded-For
PROXY_CONFIABLE=0
# Solo desarrollo: PostgreSQL local
PG_LOCAL_PUERTO=54329
PG_LOCAL_CLAVE=
# Conexiones a la base de datos normal y a la de pruebas
DATABASE_URL=
DATABASE_URL_PRUEBAS=
# Firman las sesiones. Deben ser distintos entre si.
SESION_SECRETO_SOCIOS=
SESION_SECRETO_ADMINS=
# Protege correo e IP en los intentos de acceso
HUELLAS_SECRETO=
# Protege la migracion remota
MIGRATE_SECRET=
# archivo (desarrollo) | smtp
CORREO_MODO=archivo
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
