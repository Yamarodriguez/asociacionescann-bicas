# Copia documentada de las variables de entorno. Sin valores reales.
# En desarrollo, `npm run preparar` crea .env con secretos aleatorios.
# Para Netlify, `npm run netlify:variables` crea sus propios secretos.

# desarrollo | pruebas | produccion
ENTORNO=desarrollo
# Solo desarrollo: puerto del servidor y PostgreSQL local
PUERTO=8080
PG_LOCAL_PUERTO=54329
PG_LOCAL_CLAVE=
# Solo desarrollo: en Netlify la conexion la da la propia plataforma
DATABASE_URL=
DATABASE_URL_PRUEBAS=
# Firman las sesiones. Deben ser distintos entre si.
SESION_SECRETO_SOCIOS=
SESION_SECRETO_ADMINS=
# Protege correo e IP en los intentos de acceso
HUELLAS_SECRETO=
# Cifran el doble factor y las copias: 32 bytes en hexadecimal.
# Sin COPIA_CLAVE no se puede recuperar ninguna copia. Guardala aparte.
TOTP_CLAVE=
COPIA_CLAVE=
# archivo (desarrollo) | ninguno (el prototipo publicado no envia correos)
CORREO_MODO=archivo
# Solo en la version publicada de prueba: carga de datos inventados
DEMO_CLAVE=
