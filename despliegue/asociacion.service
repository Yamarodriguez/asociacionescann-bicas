[Unit]
Description=Sistema de la asociacion
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=asociacion
Group=asociacion
WorkingDirectory=/opt/asociacion
ExecStart=/opt/asociacion/.venv/bin/python servidor.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/asociacion/.dev

[Install]
WantedBy=multi-user.target
