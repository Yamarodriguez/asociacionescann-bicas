[Unit]
Description=Copia de seguridad de la base de datos
After=postgresql.service

[Service]
Type=oneshot
User=asociacion
Group=asociacion
UMask=0077
WorkingDirectory=/opt/asociacion
ExecStart=/opt/asociacion/.venv/bin/python -m scripts.copia crear /var/backups/asociacion
ExecStartPost=/usr/bin/find /var/backups/asociacion -name "copia-*.bin" -mtime +7 -delete
